# Public Supabase project configuration. These values are safe to expose only
# when the database and Storage policies use least privilege and RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Never expose this in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only OpenAI configuration. No provider call is made until an approved
# feature uses the AI provider boundary.
OPENAI_API_KEY=
OPENAI_MODEL=
